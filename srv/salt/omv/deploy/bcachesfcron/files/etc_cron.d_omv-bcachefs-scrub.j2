# Managed by openmediavault-bcachefs plugin. Do not edit manually.
{%- set separator = ' ' -%}
{#- quote a value as one shell word; cron turns an unescaped % into a newline -#}
{%- macro shq(value) -%}
'{{ value | string | replace('\n', ' ') | replace("'", "'\\''") | replace('%', '\\%') }}'
{%- endmacro -%}
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
# m h dom mon dow user    command
{%- for job in jobs | selectattr('enable') %}
{% if job.execution == "exactly" -%}
{% if job.everynminute | to_bool %}*/{{ job.minute }}{% else %}{{ job.minute }}{% endif -%}
{{ separator }}{% if job.everynhour | to_bool %}*/{{ job.hour }}{% else %}{{ job.hour }}{% endif -%}
{{ separator }}{% if job.everyndayofmonth | to_bool %}*/{{ job.dayofmonth }}{% else %}{{ job.dayofmonth }}{% endif -%}
{{ separator }}{{ job.month }}{{ separator }}{{ job.dayofweek }}
{%- else -%}
@{{ job.execution }}
{%- endif -%}
{{ separator }}root{{ separator }}/usr/sbin/omv-bcachefs-scrub {{ shq(job.fsuuid) }}
{%- if job.sendemail | to_bool %} -e {{ 'onerror' if job.emailonerror | to_bool else 'always' }}{% if job.comment | length > 0 %} -c {{ shq(job.comment) }}{% endif %}{% endif -%}
{{ separator }}>/dev/null 2>&1
{%- endfor %}
