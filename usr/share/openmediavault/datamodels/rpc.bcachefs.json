  {
    "type": "rpc",
    "id": "rpc.bcachefs.enableautounlock",
    "params": {
      "type": "object",
      "properties": {
        "uuid":       { "type": "string", "required": true },
        "passphrase": { "type": "string", "required": true }
      }
    }
  },
  {
    "type": "rpc",
    "id": "rpc.bcachefs.createfilesystem",
    "params": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 32,
          "required": false
        },
        "replicas": {
          "type": "number",
          "minimum": 1,
          "maximum": 10,
          "required": false
        },
        "foreground_target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]*$",
          "required": false
        },
        "promote_target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]*$",
          "required": false
        },
        "background_target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]*$",
          "required": false
        },
        "compression": {
          "type": "string",
          "enum": ["none", "lz4", "gzip", "zstd"],
          "required": false
        },
        "checksum": {
          "type": "string",
          "enum": ["none", "crc32c", "crc64", "xxhash"],
          "required": false
        },
        "nocow": {
          "type": "boolean",
          "required": false
        },
        "encrypted": {
          "type": "boolean",
          "required": false
        },
        "passphrase": {
          "type": "string",
          "required": false
        },
        "autounlock": {
          "type": "boolean",
          "required": false
        },
        "enablegroups": {
          "type": "boolean",
          "required": false
        },
        "erasurecode": {
          "type": "boolean",
          "required": false
        },
        "group1name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "required": false
        },
        "group1failuredomain": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]*$",
          "required": false
        },
        "group1devices": {
          "type": "string",
          "required": false
        },
        "group2name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "required": false
        },
        "group2failuredomain": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]*$",
          "required": false
        },
        "group2devices": {
          "type": "string",
          "required": false
        },
        "group3name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "required": false
        },
        "group3failuredomain": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]*$",
          "required": false
        },
        "group3devices": {
          "type": "string",
          "required": false
        },
        "devicefiles": {
          "type": "string",
          "required": false
        },
        "missing_dev_timeout": {
          "type": "integer",
          "minimum": 0,
          "required": false
        }
      }
    }
  },
  {
    "type": "rpc",
    "id": "rpc.bcachefs.setfilesystemoptions",
    "params": {
      "type": "object",
      "properties": {
        "uuid": { "type": "string", "required": true },
        "compression": {
          "type": "string",
          "enum": ["none", "lz4", "gzip", "zstd"],
          "required": false
        },
        "background_compression": {
          "type": "string",
          "enum": ["none", "lz4", "gzip", "zstd"],
          "required": false
        },
        "foreground_target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]*$", "required": false },
        "background_target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]*$", "required": false },
        "promote_target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]*$", "required": false },
        "write_degraded": {
          "type": "string",
          "enum": ["degraded", "yes", "no"],
          "required": false
        },
        "missing_dev_timeout": {
          "type": "integer",
          "minimum": 0,
          "required": false
        },
        "data_replicas": {
          "type": "number",
          "minimum": 1,
          "maximum": 10,
          "required": false
        }
      }
    }
  },
  {
    "type": "rpc",
    "id": "rpc.bcachefs.adddevice",
    "params": {
      "type": "object",
      "properties": {
        "uuid": { "type": "string", "required": true },
        "devicefile": { "type": "string", "required": true },
        "label": { "type": "string", "pattern": "^[A-Za-z0-9_.-]*$", "required": false },
        "failure_domain": { "type": "string", "pattern": "^[A-Za-z0-9_.-]*$", "required": false }
      }
    }
  },
  {
    "type": "rpc",
    "id": "rpc.bcachefs.setdevicefailuredomain",
    "params": {
      "type": "object",
      "properties": {
        "uuid": { "type": "string", "required": true },
        "devicefile": { "type": "string", "required": true },
        "failure_domain": { "type": "string", "pattern": "^[A-Za-z0-9_.-]*$", "required": true }
      }
    }
  },
  {
    "type": "rpc",
    "id": "rpc.bcachefs.removedevice",
    "params": {
      "type": "object",
      "properties": {
        "devicefile": { "type": "string", "required": true },
        "uuid": { "type": "string", "required": false },
        "slot": { "type": "integer", "minimum": 0, "required": false }
      }
    }
  },
  {
    "type": "rpc",
    "id": "rpc.bcachefs.offlinedevice",
    "params": {
      "type": "object",
      "properties": {
        "devicefile": { "type": "string", "required": true },
        "force": { "type": "boolean", "required": false }
      }
    }
  },
  {
    "type": "rpc",
    "id": "rpc.bcachefs.devicefile",
    "params": {
      "type": "object",
      "properties": {
        "devicefile": { "type": "string", "required": true }
      }
    }
  },
  {
    "type": "rpc",
    "id": "rpc.bcachefs.setdevicestate",
    "params": {
      "type": "object",
      "properties": {
        "devicefile": { "type": "string", "required": true },
        "state": {
          "type": "string",
          "enum": ["rw", "ro", "failed", "evacuating", "spare"],
          "required": true
        }
      }
    }
  },
  {
    "type": "rpc",
    "id": "rpc.bcachefs.setsnapshotjob",
    "params": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "required": true
        },
        "enable": {
          "type": "boolean",
          "required": true
        },
        "subvolume": {
          "type": "string",
          "required": true
        },
        "prefix": {
          "type": "string",
          "required": true
        },
        "retention": {
          "type": "integer",
          "minimum": 1,
          "required": true
        },
        "retentionunit": {
          "type": "string",
          "enum": ["count", "days", "weeks", "months", "years"]
        },
        "readonly": {
          "type": "boolean"
        },
        "execution": {
          "type": "string",
          "enum": [
            "exactly", "hourly", "daily", "weekly",
            "monthly", "yearly", "reboot"
          ],
          "required": true
        },
        "minute": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hour": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dayofmonth": {
          "type": "array",
          "items": { "type": "string" }
        },
        "month": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dayofweek": {
          "type": "array",
          "items": { "type": "string" }
        },
        "everynminute": { "type": "boolean" },
        "everynhour": { "type": "boolean" },
        "everyndayofmonth": { "type": "boolean" },
        "sendemail": { "type": "boolean" },
        "emailonerror": { "type": "boolean" },
        "comment": { "type": "string" }
      }
    }
  },
  {
    "type": "rpc",
    "id": "rpc.bcachefs.setscrubjob",
    "params": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "required": true
        },
        "enable": {
          "type": "boolean",
          "required": true
        },
        "fsuuid": {
          "type": "string",
          "required": true
        },
        "execution": {
          "type": "string",
          "enum": [
            "exactly", "hourly", "daily", "weekly",
            "monthly", "yearly", "reboot"
          ],
          "required": true
        },
        "minute": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hour": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dayofmonth": {
          "type": "array",
          "items": { "type": "string" }
        },
        "month": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dayofweek": {
          "type": "array",
          "items": { "type": "string" }
        },
        "everynminute": { "type": "boolean" },
        "everynhour": { "type": "boolean" },
        "everyndayofmonth": { "type": "boolean" },
        "sendemail": { "type": "boolean" },
        "emailonerror": { "type": "boolean" },
        "comment": { "type": "string" }
      }
    }
  }
