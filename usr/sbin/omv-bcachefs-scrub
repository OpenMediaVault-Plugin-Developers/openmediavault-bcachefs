#!/bin/bash
# Run a bcachefs data scrub for a filesystem UUID.
# Usage: omv-bcachefs-scrub <uuid> [-e always|onerror] [-c comment]
set -euo pipefail

LOGFILE="/var/log/omv-bcachefs-scrub.log"

UUID="$1"
shift

email_mode=""
email_comment=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -e) email_mode="$2"; shift 2 ;;
        -c) email_comment="$2"; shift 2 ;;
        *) shift ;;
    esac
done

tmpfile=""
if [ -n "${email_mode}" ]; then
    tmpfile=$(mktemp)
    exec > "${tmpfile}" 2>&1
else
    exec > >(tee -a "${LOGFILE}") 2>&1
fi

_send_email() {
    local rc="$1"
    if [ -f "${tmpfile:-}" ]; then
        cat "${tmpfile}" >> "${LOGFILE}"
    fi
    if [ -n "${email_mode}" ] && [ -f "${tmpfile:-}" ]; then
        if [ "${email_mode}" = "always" ] || \
           { [ "${email_mode}" = "onerror" ] && [ "${rc}" -ne 0 ]; }; then
            mail -E -s "Bcachefs Scrub${email_comment:+ - ${email_comment}}" \
                 -a "From: Cron Daemon <root>" root < "${tmpfile}" >/dev/null 2>&1
        fi
        rm -f "${tmpfile}"
    fi
}
trap '_send_email $?' EXIT

# Scrub through the mount point. Given a device path, bcachefs scrubs only
# that one member, and /dev/disk/by-uuid/<uuid> points at a single member of
# a multi-device filesystem.
MOUNTPOINT=$(awk -v uuid="${UUID}" '
    $3 == "bcachefs" && $2 ~ ("dev-disk-by-uuid-" uuid "$") { print $2; exit }
' /proc/mounts)
MOUNTPOINT=$(printf '%b' "${MOUNTPOINT}")
if [ -z "${MOUNTPOINT}" ]; then
    echo "$(date -Iseconds): ERROR: bcachefs filesystem ${UUID} is not mounted" >&2
    exit 1
fi

echo "$(date -Iseconds): Starting bcachefs scrub on ${MOUNTPOINT} (UUID: ${UUID})"
bcachefs scrub "${MOUNTPOINT}"
echo "$(date -Iseconds): Scrub completed successfully."

# Scrub repairs what it can from other copies; files it could not repair
# are recorded as damaged (bcachefs-tools 1.39.5+). List them so they show
# up in the log and the notification email, and fail the job so "on error"
# notifications fire. Records stay until cleared under Storage > Bcachefs.
if bcachefs damage --help >/dev/null 2>&1; then
    damaged=$(bcachefs damage ls -R "${MOUNTPOINT}" 2>&1) || {
        echo "$(date -Iseconds): WARNING: could not list damaged files: ${damaged}"
        exit 0
    }
    if [ -n "${damaged}" ]; then
        echo "$(date -Iseconds): Damaged files recorded on ${MOUNTPOINT}:"
        printf '%s\n' "${damaged}"
        exit 2
    fi
    echo "$(date -Iseconds): No damaged files recorded."
fi
