#!/bin/bash
# Auto-unlock bcachefs encrypted filesystems at boot.
# Key files are stored in /etc/bcachefs/keys/<uuid>.key (mode 600, owned by root).
# This script is run by bcachefs-autounlock.service before local-fs.target.

set -euo pipefail

KEYS_DIR="/etc/bcachefs/keys"

if [ ! -d "$KEYS_DIR" ]; then
    exit 0
fi

# Detect whether this bcachefs-tools build supports `wait-devices` (added in
# bcachefs-tools 1.38.1). When available we use it to wait for all member
# devices of a multi-device filesystem to appear before unlocking, avoiding
# boot-time races.
wait_devices_supported=0
if /usr/sbin/bcachefs wait-devices --help >/dev/null 2>&1; then
    wait_devices_supported=1
fi

for keyfile in "$KEYS_DIR"/*.key; do
    [ -f "$keyfile" ] || continue

    uuid=$(basename "$keyfile" .key)
    device="/dev/disk/by-uuid/$uuid"

    if [ ! -e "$device" ]; then
        echo "bcachefs-autounlock: device $device not found, skipping" >&2
        continue
    fi

    # Wait for all member devices of the (possibly multi-device) filesystem to
    # be present before attempting to unlock. Bounded so a missing/failed
    # device cannot stall boot indefinitely.
    if [ "$wait_devices_supported" -eq 1 ]; then
        timeout 30 /usr/sbin/bcachefs wait-devices "$device" 2>/dev/null || \
            echo "bcachefs-autounlock: wait-devices timed out for $uuid, continuing" >&2
    fi

    if /usr/sbin/bcachefs unlock "$device" < "$keyfile" 2>/dev/null; then
        echo "bcachefs-autounlock: unlocked $uuid"
    else
        echo "bcachefs-autounlock: failed to unlock $uuid (wrong passphrase or already unlocked)" >&2
    fi
done
